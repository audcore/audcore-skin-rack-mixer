{
  "id": "cn.audcore.rack-mixer",
  "name": "机架调音台",
  "author": "Audcore",
  "version": "0.1.4",
  "api": {
    "major": 1,
    "minor": 0
  },
  "entry": "web/rack.html",
  "window": {
    "default": [
      820,
      560
    ],
    "min": [
      320,
      240
    ],
    "max": null,
    "resizable": true,
    "maximizable": true
  },
  "themes": [
    "dark",
    "light"
  ],
  "scale": {
    "min": 0.75,
    "max": 2,
    "default": 1
  },
  "languages": [
    "zh",
    "en",
    "ja"
  ],
  "preview": "assets/preview.png",
  "kind": "web",
  "license": "MIT",
  "repository": "https://github.com/audcore/audcore-skin-rack",
  "description": "机架调音台，声核独立网页皮肤",
  "build": {
    "schema": 1,
    "recipe": "web-static",
    "platform": "windows-x86_64",
    "toolchain": {
      "tools": {
        "node": "24.12.0"
      }
    },
    "files": [
      "LICENSE",
      "assets/preview.png",
      "web/channel-color.mjs",
      "web/channel-name.mjs",
      "web/i18n-cache.mjs",
      "web/latency.mjs",
      "web/link-slots.mjs",
      "web/logo-sliders.svg",
      "web/meters.mjs",
      "web/page.mjs",
      "web/pending-toggle.mjs",
      "web/rack.css",
      "web/rack.html",
      "web/send-label.mjs",
      "web/send-targets.mjs",
      "web/skin-menu.css",
      "web/skin-menu.mjs",
      "web/skin.css",
      "web/skin.mjs",
      "web/startup.mjs",
      "web/transport-control.mjs",
      "web/webview-bridge.mjs",
      "web/window-controls.mjs"
    ]
  }
}
